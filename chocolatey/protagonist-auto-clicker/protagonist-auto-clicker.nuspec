<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>protagonist-auto-clicker</id>
    <version>1.0.6</version>
    <title>Auto Clicker</title>
    <authors>Protagonist Labs</authors>
    <owners>protagonistlabs</owners>
    <projectUrl>https://protagonistlabs.app/autoclicker/</projectUrl>
    <iconUrl>https://protagonistlabs.app/icons/autoclicker.png</iconUrl>
    <licenseUrl>https://github.com/limburatorul/auto-clicker/blob/HEAD/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/limburatorul/auto-clicker</projectSourceUrl>
    <packageSourceUrl>https://github.com/limburatorul/scoop-bucket/tree/main/chocolatey/protagonist-auto-clicker</packageSourceUrl>
    <bugTrackerUrl>https://github.com/limburatorul/auto-clicker/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/limburatorul/auto-clicker/releases/tag/v1.0.6</releaseNotes>
    <tags>auto-clicker autoclicker mouse-automation macro windows-11 open-source windows foss</tags>
    <summary>Free auto clicker with routes and scripts that wait for an image.</summary>
    <description>Auto Clicker is a free, open-source auto clicker for Windows 11 and 10.

Start and stop it with a global hotkey (F6 by default) that works from any window. It clicks at the cursor or along a route of saved points, at intervals down to 1 ms or within a random range.

For anything longer than a click, the script editor has seven step types, with loops and If image / If pixel branches. A script can wait until an image appears on screen and then click it, so a button is clicked when it shows up and not before.

It is one portable file: nothing to install, no account, no licence key, no ads and no telemetry. GPL-3.0, source on GitHub.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
